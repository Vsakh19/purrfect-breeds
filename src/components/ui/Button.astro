---
import type { HTMLAttributes } from 'astro/types';

interface Props extends HTMLAttributes<'button'> {
    variant?: 'primary' | 'brand';
    href?: string;
}

const { variant = 'primary', href, class: className, type = 'button', ...rest } = Astro.props;
const Tag = href ? 'a' : 'button';
---

<Tag
    class:list={[className, 'purrfect-button', variant]}
    href={href}
    type={href ? undefined : type}
    {...rest}
>
    <slot />
</Tag>

<style>
    .purrfect-button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        height: var(--size-control);
        padding: var(--space-sm) var(--space-2xl);
        border: 0;
        border-radius: var(--radius-xl);
        font-family: var(--font-display);
        font-weight: var(--font-weight-semibold);
        font-size: var(--font-size-lg);
        white-space: nowrap;
        cursor: pointer;
    }

    @media (hover: hover) {
        .purrfect-button:hover {
            opacity: 0.85;
        }
    }

    .purrfect-button:disabled,
    .purrfect-button[aria-disabled='true'] {
        opacity: 0.5;
        pointer-events: none;
    }

    .primary {
        background: var(--color-action-primary);
        color: var(--color-text-inverse);
    }

    .brand {
        background: var(--gradient-brand-button);
        color: var(--color-text-primary);
    }
</style>
