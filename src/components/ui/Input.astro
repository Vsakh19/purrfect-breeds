---
import type { HTMLAttributes, SvgComponent } from 'astro/types';

interface Props extends HTMLAttributes<'input'> {
    label: string;
    variant?: 'outlined' | 'filled';
    inputSize?: 'md' | 'sm';
    submitIcon?: SvgComponent;
    submitLabel?: string;
}

const {
    label,
    variant = 'outlined',
    inputSize = 'md',
    submitIcon: SubmitIcon,
    submitLabel,
    class: className,
    form,
    ...restProps
} = Astro.props;
---

<div class:list={[className, 'purrfect-input', variant, inputSize, { 'with-submit': SubmitIcon }]}>
    <input form={form} class="field" aria-label={label} {...restProps} />
    {SubmitIcon && (
        <button class="submit" form={form} type="submit" aria-label={submitLabel}>
            <SubmitIcon />
        </button>
    )}
</div>

<style>
    .purrfect-input {
        display: flex;
        align-items: center;
        gap: var(--space-xs);
        padding-inline: var(--space-md);
    }

    .field {
        flex: 1;
        min-width: 0;
        padding: 0;
        border: 0;
        background: transparent;
        appearance: none;
    }

    .md {
        height: var(--size-input);
        border-radius: var(--radius-lg);
    }

    .sm {
        height: var(--size-header-search);
        border-radius: var(--radius-md);
    }

    .outlined {
        border: var(--border-width) solid var(--color-border-default);
        background: var(--color-bg-elevated);
        font-family: var(--font-input);
    }

    .outlined .field::placeholder {
        color: var(--color-text-placeholder);
    }

    .filled {
        background: var(--color-bg-surface);
    }

    .filled .field::placeholder {
        color: var(--color-text-tertiary);
    }

    .with-submit {
        padding-inline-end: var(--space-2xs-plus);
    }

    .submit {
        display: flex;
        flex-shrink: 0;
        align-items: center;
        justify-content: center;
        width: var(--size-search-button);
        height: var(--size-search-button);
        padding: 0;
        border: 0;
        border-radius: var(--radius-round);
        background: var(--color-bg-inverse);
        color: var(--color-text-inverse);
        cursor: pointer;
    }
</style>
