---
import Container from '../ui/Container.astro';
import Button from '../ui/Button.astro';
import heroImage from '../../assets/images/hero.png';
import Image from 'astro/components/Image.astro';
import BlobTop from '../../assets/decor/blob-1.svg';
import BlobBottom from '../../assets/decor/blob-2.svg';
import { useTranslations } from '../../i18n';

const t = useTranslations(Astro.currentLocale);
---

<section class="hero" aria-labelledby="hero-title">
    <Image
        class="bg"
        src={heroImage}
        alt=""
        widths={[768, 1440]}
        sizes="100vw"
        loading="eager"
        fetchpriority="high"
    />
    <BlobTop class="blob blob-top" aria-hidden="true" />
    <BlobBottom class="blob blob-bottom" aria-hidden="true" />

    <Container class="container">
        <div class="content">
            <div class="main-title-block">
                <p class="eyebrow">{t.hero.eyebrow}</p>
                <h1 id="hero-title" class="title">
                    {t.hero.title}
                </h1>
            </div>
            <p class="desc">{t.hero.lead}</p>
            <Button href="#breed-explorer">{t.hero.cta}</Button>
        </div>
    </Container>
</section>

<style>
    .hero {
        position: relative;
        display: flex;
        flex-direction: column;
        justify-content: center;
        min-height: var(--hero-min-height);
        padding-block: calc(var(--hero-padding) + var(--size-logo-height) + 2 * var(--space-md))
            var(--hero-padding);
        overflow: hidden;
    }

    .bg {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .blob {
        position: absolute;
    }

    .blob-top {
        top: 0;
        left: 224px;
    }

    .blob-bottom {
        bottom: 0;
        left: 530px;
    }

    .container {
        position: relative;
    }

    .content {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        gap: var(--space-4xl);
    }

    .main-title-block {
        display: flex;
        flex-direction: column;
        gap: var(--space-xl);
        max-width: var(--hero-title-max);
    }

    .eyebrow {
        color: var(--color-text-inverse);
        font-family: var(--font-body);
        font-weight: var(--font-weight-bold);
    }

    .title,
    .desc {
        text-box: trim-both cap alphabetic;
    }

    .desc {
        max-width: var(--content-max);
        color: var(--color-text-secondary);
        font-family: var(--font-body);
        line-height: var(--line-height-lg);
    }
</style>
